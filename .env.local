REACT_APP_API_URL=http://localhost:5050/api

# Google Sign-In. This is a CLIENT ID, not a secret -- it is meant to be
# visible in the page source, which is exactly what a React "REACT_APP_"
# env var becomes at build time. Must be the SAME value as server/.env's
# GOOGLE_CLIENT_ID -- see that file's comment for how to get one.
# Leave unset and the "Sign in with Google" button simply does not render
# (see components/auth/GoogleSignInButton.js) -- nothing else in the app
# is affected.
# REACT_APP_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
